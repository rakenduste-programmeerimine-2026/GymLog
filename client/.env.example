# Copy to .env.local and fill in your project's public browser credentials.
# Leave blank until the Supabase project owner provides them.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Never use a service_role key, sb_secret key, or database password here.
# Backend API origin, separate from the Supabase project URL.
# Set this to your backend URL (optional /api prefix); no query, fragment, or credentials.
# The runtime has no hardcoded fallback. Restart Vite after changing this value.
VITE_API_URL=http://localhost:3001
